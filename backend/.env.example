NODE_ENV=production
PORT=3001

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://pravchik.ru,https://www.pravchik.ru,http://localhost:5173

# Postgres (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Redis (Upstash). Note: use rediss:// (TLS) for Upstash
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# JWT — long random string
JWT_SECRET=replace-with-64-char-random
JWT_TTL=15m
REFRESH_TTL_DAYS=30

# S3-compatible (Cloudflare R2)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fitai
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://images.pravchik.ru

AI_PROVIDER=stub
ADMIN_EMAILS=malaninaaaa@gmail.com
