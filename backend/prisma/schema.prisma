generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  createdAt    DateTime  @default(now())

  height       Int?
  weight       Int?
  bodyType     String?
  style        String?
  favorites    String[]  @default([])

  photos       Photo[]
  tryOnJobs    TryOnJob[]
  outfits      Outfit[]
  refreshTokens RefreshToken[]
  cart         Cart?
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  key       String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tryOnJobs TryOnJob[]

  @@index([userId])
}

model CatalogItem {
  id          String   @id
  cat         String
  name        String
  price       Int
  emoji       String?
  tone        String?
  accent      String?
  dark        Boolean  @default(false)
  imageUrl    String?
  brand       String?
  purchaseUrl String?
  priceCents  Int?
  currency    String   @default("RUB")
  createdAt   DateTime @default(now())

  tryOnJobs TryOnJob[]
  cartItems CartItem[]
}

enum TryOnStatus {
  pending
  processing
  done
  failed
}

model TryOnJob {
  id            String      @id @default(cuid())
  userId        String
  photoId       String
  catalogItemId String
  size          String?
  status        TryOnStatus @default(pending)
  resultUrl     String?
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo       Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([userId, status])
}

model Outfit {
  id          String   @id @default(cuid())
  userId      String
  name        String?
  itemIds     String[]
  shareToken  String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  catalogItemId String
  size          String?
  qty           Int      @default(1)
  addedAt       DateTime @default(now())

  cart        Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@unique([cartId, catalogItemId, size])
  @@index([cartId])
}
